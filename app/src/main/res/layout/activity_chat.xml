<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackgroundColor">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/appPrimaryColor"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat with Vela"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            tools:ignore="HardcodedText" />
    </RelativeLayout>

    <!-- Chat Messages Area -->
    <ScrollView
        android:id="@+id/svChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:scrollbarThumbVertical="@null">

        <LinearLayout
            android:id="@+id/llChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Suggestions Area -->
    <HorizontalScrollView
        android:id="@+id/hsvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="60dp"
        android:background="?attr/appCardBackgroundColor"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="Ask Vela anything..."
            android:hint="Ask Vela anything..."
            android:background="@android:color/transparent"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:maxLines="4"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnSendChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:backgroundTint="?attr/appPrimaryColor"
            android:textColor="#FFFFFF"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</LinearLayout>
