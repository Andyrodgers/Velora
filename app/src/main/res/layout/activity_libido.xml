<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header with Privacy Toggle -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wellness Center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/appPrimaryColor"
                tools:ignore="HardcodedText" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPrivacyToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="10dp"
                android:src="@drawable/secret_chats_icon"
                android:background="?attr/appCardBackgroundColor"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="?attr/appPrimaryColor"
                app:strokeWidth="1dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Partner Chat" />
        </RelativeLayout>

        <!-- 1. Daily Libido Level Selector -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Daily Libido Level"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <RadioGroup
                    android:id="@+id/rgLibido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton android:id="@+id/rbVeryLow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="❄️\nVery Low" android:button="@null" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:textColor="?attr/appTextColor" />
                    <RadioButton android:id="@+id/rbLow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☁️\nLow" android:button="@null" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:textColor="?attr/appTextColor" />
                    <RadioButton android:id="@+id/rbNormal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✨\nNormal" android:button="@null" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:textColor="?attr/appTextColor" />
                    <RadioButton android:id="@+id/rbHigh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔥\nHigh" android:button="@null" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:textColor="?attr/appTextColor" />
                    <RadioButton android:id="@+id/rbVeryHigh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌋\nVery High" android:button="@null" android:gravity="center" android:textSize="10sp" android:padding="4dp" android:textColor="?attr/appTextColor" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvLibidoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Normal"
                    android:textColor="?attr/appPrimaryColor"
                    android:layout_marginTop="8dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Libido vs Cycle Insight & Small Chart -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Libido vs Cycle Insight"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCycleLibidoInsight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Scientific fact: Your sex drive is usually higher during ovulation."
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <!-- Mini Chart Sim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    <View android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:background="?attr/appSecondaryColor" android:layout_margin="2dp" />
                    <View android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:background="?attr/appPrimaryColor" android:layout_margin="2dp" />
                    <View android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:background="?attr/appPrimaryColor" android:layout_margin="2dp" />
                    <View android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:background="?attr/appPrimaryColor" android:layout_margin="2dp" />
                    <View android:layout_width="0dp" android:layout_height="15dp" android:layout_weight="1" android:background="?attr/appSecondaryColor" android:layout_margin="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cycle Phase Progress (Comparison)"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Hormonal Explanation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHormonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Hormonal Explanation"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvHormonalFact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Estrogen rising → Higher desire\n• Progesterone rising → Lower desire\n• PMS phase → Mood-dependent"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Intimacy Suggestions -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💞 Intimacy Suggestions"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvLibidoSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Select a level to see suggestions."
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Pattern Tracking -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Pattern Tracking"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvPatternTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Weekly average: Calculating...\nYour highest days: Usually Day 13–15."
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. Notes Section -->
        <EditText
            android:id="@+id/etLibidoNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="📝 Personal Notes (e.g. 'Felt affectionate', 'Stress reduced mood')"
            android:background="?attr/appCardBackgroundColor"
            android:padding="12dp"
            android:gravity="top"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText,Autofill" />

        <!-- 8. Partner Insight -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/appCardBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ Partner Insight"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextColor"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvPartnerInsight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Encouragement: You are loved! Sharing your wellness helps your partner support you better."
                    android:textColor="?attr/appPrimaryColor"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveLibido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="SAVE WELLNESS DATA"
            android:backgroundTint="?attr/appPrimaryColor"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</ScrollView>
