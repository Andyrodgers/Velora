<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textSize="28sp"
            android:textColor="?attr/appPrimaryColor"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivInfoPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:padding="2dp"
            android:src="@drawable/user_account_icon"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="?attr/appPrimaryColor"
            app:strokeWidth="2dp"
            tools:ignore="ContentDescription" />

        <Button
            android:id="@+id/btnChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Photo"
            android:backgroundTint="?attr/appSecondaryColor"
            android:layout_marginBottom="24dp"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etInfoName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:autofillHints="name"
            android:hint="Full Name"
            android:background="@drawable/edit_text_rounded"
            android:inputType="textPersonName"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etInfoAge"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:autofillHints="none"
            android:hint="Age"
            android:inputType="number"
            android:background="@drawable/edit_text_rounded"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etInfoEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:autofillHints="emailAddress"
            android:hint="Email"
            android:background="@drawable/edit_text_rounded"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etInfoPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:autofillHints="phone"
            android:hint="Mobile Number"
            android:background="@drawable/edit_text_rounded"
            android:inputType="phone"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:textColor="?attr/appTextColor"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnSaveInfo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE CHANGES"
            android:backgroundTint="?attr/appPrimaryColor"
            android:textColor="#FFFFFF"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</ScrollView>