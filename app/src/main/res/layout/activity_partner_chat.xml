<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <LinearLayout
        android:id="@+id/chatLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/appPrimaryColor"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPartnerPhoto"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:src="@drawable/user_account_icon"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:padding="1dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/ivPartnerPhoto"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvPartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partner"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvPartnerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline"
                    android:textSize="12sp"
                    android:textColor="#E0E0E0"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatSettings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#FFFFFF"
                android:contentDescription="Settings" />
        </RelativeLayout>

        <!-- Chat Messages List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPartnerMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false"
            tools:listitem="@android:layout/simple_list_item_1" />

        <!-- Reply Preview above Input -->
        <LinearLayout
            android:id="@+id/llReplyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:visibility="gone">
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="?attr/appPrimaryColor"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:id="@+id/tvReplyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/appPrimaryColor"/>
                <TextView
                    android:id="@+id/tvReplyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#666666"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnCancelReply"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@null"
                app:tint="#888888"/>
        </LinearLayout>

        <!-- Input Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="60dp"
            android:background="?attr/appCardBackgroundColor"
            android:gravity="center_vertical"
            android:elevation="4dp">

            <EditText
                android:id="@+id/etPartnerMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type a message..."
                android:background="@drawable/dialog_circle_bg"
                android:backgroundTint="#F0F0F0"
                android:padding="12dp"
                android:maxLines="4"
                android:textColor="#000000"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/btnSendPartnerMessage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_send"
                android:background="?android:attr/selectableItemBackground"
                app:tint="?attr/appPrimaryColor"
                android:contentDescription="Send"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay for PIN -->
    <LinearLayout
        android:id="@+id/pinOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="?attr/appBackgroundColor"
        android:visibility="visible">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="?attr/appPrimaryColor"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat Protected"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/appPrimaryColor"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your PIN to view messages"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginBottom="32dp"
            android:textAlignment="center"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            app:boxStrokeColor="?attr/appPrimaryColor"
            app:hintTextColor="?attr/appPrimaryColor"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="4-Digit PIN"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textAlignment="center"
                android:textSize="20sp"
                android:letterSpacing="0.5"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnUnlockChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Unlock"
            android:padding="12dp"
            android:backgroundTint="?attr/appPrimaryColor"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/btnBackFromChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go Back"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:textColor="?attr/appPrimaryColor"
            android:textStyle="bold"/>

    </LinearLayout>

</FrameLayout>